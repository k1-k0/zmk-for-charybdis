#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define QT_MS 180
#define HMR_RPI_MS 175
#define HCMB_RPI_MS 150
#define VCMB_RPI_MS 50
#define VCMB_MS 35
#define HCMB_MS 25
#define TCMB_RPI_MS 50
#define TCMB_MS 25
#define LHYPER LA(LC(LS(LGUI)))
#define RHYPER RS(RC(RA(RGUI)))

#define MSHFT &mshft RSHFT 0

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&sk {
    release-after-ms = <900>;
    quick-release;
};

/ {
    behaviors {
        lpht: left_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <QT_MS>;
            require-prior-idle-ms = <HMR_RPI_MS>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55>;
            hold-trigger-on-release;
        };

        rpht: right_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <QT_MS>;
            require-prior-idle-ms = <HMR_RPI_MS>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52>;
            hold-trigger-on-release;
        };

        mshftm: magic_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk RSHFT>, <&caps_word>;

            mods = <(MOD_RSFT)>;
        };

        mshft: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mshftm>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <160>;
            require-prior-idle-ms = <HMR_RPI_MS>;
        };
    };

    app_swap: app_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;

        ignored-key-positions = <15>;
    };

    appw_swap: app_win_swapper {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LGUI>, <&kp GRAVE>, <&kt LGUI>;

        ignored-key-positions = <39>;
    };

    tbbr: tabber {
        compatible = "zmk,behavior-tri-state";
        #binding-cells = <0>;
        bindings = <&kt LCTRL>, <&kp TAB>, <&kt LCTRL>;

        ignored-key-positions = <37>;
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&sk LHYPER   &kp N1        &kp N2        &kp N3         &kp N4         &kp N5       &kp N6   &kp N7         &kp N8         &kp N9        &kp N0           &kp BSLH
&kp RBKT     &kp Q         &kp W         &kp E          &kp R          &kp T        &kp Y    &kp U          &kp I          &kp O         &kp P            &kp LBKT
&kp GRAVE    &lpht LCMD A  &lpht LALT S  &lpht LCTRL D  &lpht LSHFT F  &kp G        &kp H    &rpht RSHFT J  &rpht RCTRL K  &rpht RALT L  &rpht RGUI SEMI  &kp APOS
&lt 2 MINUS  &kp Z         &kp X         &kp C          &kp V          &kp B        &kp N    &kp M          &kp COMMA      &kp DOT       &kp SLASH        &lt 2 EQUAL
                                         MSHFT          &lt 1 SPACE    &kp ENTER    &kp ESC  &lt 3 BSPC
                                                        &kp TAB        &kp F14      &kp F15
            >;
        };

        nav {
            bindings = <
&kp F12  &kp F1       &kp F2    &kp F3         &kp F4      &kp F5        &kp F6     &kp F7            &kp F8          &kp F9            &kp F10         &kp F11
&trans   &sk LHYPER   &kp ESC   &kp LS(TAB)    &app_swap   &trans        &kp HOME   &kp PG_DN         &kp PG_UP       &kp END           &sk RHYPER      &trans
&trans   &sk LGUI     &sk LALT  &sk LCTRL      &sk LSHFT   &caps_word    &kp LEFT   &rpht RSHFT DOWN  &rpht RCTRL UP  &rpht RALT RIGHT  &rpht RGUI ESC  &trans
&trans   &kp LS(TAB)  &tbbr     &kp LS(GRAVE)  &appw_swap  &kp ENTER     &kp ENTER  &kp TAB           &kp BSPC        &kp DEL           &kp K_APP       &trans
                                &trans         &trans      &trans        &trans     &trans
                                               &trans      &trans        &trans
            >;
        };

        mou {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &trans        &mkp RCLK     &mo 5         &mkp LCLK  &none         &none       &mkp LCLK  &mo 5         &mkp RCLK     &trans        &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        fun {
            bindings = <
&kp F12  &kp F1    &kp F2    &kp F3     &kp F4     &kp F5    &kp F6           &kp F7                &kp F8                &kp F9           &kp F10         &kp F11
&trans   &trans    &trans    &trans     &trans     &trans    &kp PAUSE_BREAK  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans           &trans          &trans
&trans   &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &trans    &kp C_PREV       &mt RSHFT C_VOL_DN    &mt RCTRL C_VOL_UP    &mt RALT C_NEXT  &mt RGUI PSCRN  &trans
&trans   &trans    &trans    &trans     &trans     &trans    &kp DEL          &kp C_STOP            &kp C_MUTE            &kp C_PP         &trans          &trans
                             &trans     &trans     &trans    &trans           &trans
                                        &trans     &trans    &trans
            >;
        };

        layer_4 {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &trans        &mkp LCLK  &none         &none       &mkp LCLK  &trans        &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        nav2 {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp HASH      &kp DOLLAR    &kp DOLLAR    &kp PERCENT    &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp LBKT       &kp RBKT       &kp F1         &kp F2        &kp F3                &kp F4                 &kp BACKSPACE
&kp LSHFT  &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &none          &kp BACKSLASH  &kp F5         &kp F6        &kp F7                &kp F8                 &kp PAGE_UP
&kp LCTRL  &kp NUMBER_9     &kp NUMBER_0  &kp MINUS     &kp EQUAL     &none          &none          &kp F9         &kp F10       &kp F11               &kp F12                &kp PAGE_DOWN
                                          &kp LEFT_WIN  &kp SPACE     &trans         &kp ENTER      &kp RIGHT_ALT
                                                        &none         &none          &none
            >;
        };
    };
};
